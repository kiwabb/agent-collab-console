data: {"candidate_id": "next-app-router--issues-id", "prototype_id": "af53dadd-4b42-4557-a069-a56a1bb9ddde", "version_no": 2, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<!-- source: /issues/:id frontend/src/app/issues/[id]/page.tsx -->\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Issue AC-4821 \u00b7 Agent Collab Console</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n  :root { color-scheme: dark; }\n  body { font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif; }\n  .scrollbar-thin::-webkit-scrollbar { width: 6px; height: 6px; }\n  .scrollbar-thin::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 3px; }\n  .glow { background: radial-gradient(circle at 20% 0%, rgba(99,102,241,0.15), transparent 50%), radial-gradient(circle at 80% 100%, rgba(168,85,247,0.10), transparent 50%); }\n  .pulse-dot { animation: pulse 1.4s ease-in-out infinite; }\n  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.35} }\n  .typing::after { content: \"\u258d\"; animation: blink 1s steps(2) infinite; }\n  @keyframes blink { 50% { opacity: 0; } }\n</style>\n</head>\n<body class=\"bg-zinc-950 text-zinc-200\">\n<div class=\"relative isolate h-screen overflow-hidden bg-background text-foreground bg-zinc-950 glow\">\n  <!-- App Shell -->\n  <div class=\"flex h-full\">\n    <!-- Sidebar -->\n    <aside class=\"w-60 shrink-0 border-r border-zinc-800 bg-zinc-900/60 flex flex-col\">\n      <div class=\"h-14 flex items-center gap-2 px-4 border-b border-zinc-800\">\n        <div class=\"w-7 h-7 rounded-md bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-xs font-bold\">AC</div>\n        <div class=\"text-sm font-semibold text-zinc-100\">Agent Console</div>\n      </div>\n      <nav class=\"flex-1 px-2 py-3 space-y-0.5 text-sm\">\n        <a class=\"flex items-center gap-2 px-2 py-1.5 rounded text-zinc-400 hover:bg-zinc-800/60 hover:text-zinc-100\" href=\"#\"><span>\ud83d\udcca</span> Dashboard</a>\n        <a class=\"flex items-center gap-2 px-2 py-1.5 rounded bg-zinc-800/70 text-zinc-100\" href=\"#\"><span>\ud83c\udfab</span> Issues <span class=\"ml-auto text-[10px] bg-indigo-500/20 text-indigo-300 px-1.5 rounded\">12</span></a>\n        <a class=\"flex items-center gap-2 px-2 py-1.5 rounded text-zinc-400 hover:bg-zinc-800/60 hover:text-zinc-100\" href=\"#\"><span>\ud83e\udd16</span> Agents</a>\n        <a class=\"flex items-center gap-2 px-2 py-1.5 rounded text-zinc-400 hover:bg-zinc-800/60 hover:text-zinc-100\" href=\"#\"><span>\ud83c\udf10</span> Mesh</a>\n        <a class=\"flex items-center gap-2 px-2 py-1.5 rounded text-zinc-400 hover:bg-zinc-800/60 hover:text-zinc-100\" href=\"#\"><span>\ud83d\udcc1</span> Artifacts</a>\n        <a class=\"flex items-center gap-2 px-2 py-1.5 rounded text-zinc-400 hover:bg-zinc-800/60 hover:text-zinc-100\" href=\"#\"><span>\u2699\ufe0f</span> Settings</a>\n      </nav>\n      <div class=\"p-3 border-t border-zinc-800 text-xs text-zinc-500\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"w-2 h-2 rounded-full bg-emerald-400 pulse-dot\"></span>\n        <span>workspace: acme-prod</span>\n        </div>\n      </div>\n    </aside>\n\n    <!-- Main -->\n    <main class=\"flex-1 flex flex-col min-w-0\">\n      <!-- Header -->\n      <header class=\"h-14 shrink-0 border-b border-zinc-800 bg-zinc-900/40 flex items-center px-4 gap-3\">\n        <nav class=\"flex items-center text-sm text-zinc-400 gap-1\">\n          <span class=\"hover:text-zinc-200 cursor-pointer\">Issue</span>\n          <span class=\"text-zinc-600\">/</span>\n          <span class=\"text-zinc-100 font-medium\">AC-4821</span>\n        </nav>\n        <div class=\"ml-auto flex items-center gap-2\">\n          <span class=\"text-xs px-2 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30\">\u25cf in_progress</span>\n          <button class=\"text-xs px-3 py-1.5 rounded-md bg-zinc-800 hover:bg-zinc-700 text-zinc-200\">Steer</button>\n          <button class=\"text-xs px-3 py-1.5 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white\">Merge</button>\n          <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white text-[11px] font-semibold\">JK</div>\n        </div>\n      </header>\n\n      <!-- Issue Title Bar -->\n      <div class=\"px-6 py-4 border-b border-zinc-800 bg-zinc-900/30\">\n        <h1 class=\"text-lg font-semibold text-zinc-100\">Refactor auth middleware to support OIDC providers</h1>\n        <div class=\"mt-2 flex items-center gap-3 text-xs text-zinc-400\">\n          <span>opened by <span class=\"text-zinc-200\">@maria.chen</span></span>\n          <span class=\"text-zinc-600\">\u2022</span>\n          <span class=\"flex items-center gap-1\"><svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg> 2h ago</span>\n          <span class=\"text-zinc-600\">\u2022</span>\n          <span class=\"flex items-center gap-1 text-emerald-400\"><svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg> PR #214 open</span>\n        </div>\n      </div>\n\n      <!-- Tabs + Body -->\n      <div class=\"flex-1 overflow-hidden flex flex-col\">\n        <div class=\"px-6 pt-3 border-b border-zinc-800 flex items-center gap-1 text-sm\">\n          <button class=\"px-3 py-2 text-zinc-100 border-b-2 border-indigo-500 -mb-px font-medium\">Overview</button>\n          <button class=\"px-3 py-2 text-zinc-400 hover:text-zinc-200\">Tasks <span class=\"text-[10px] text-zinc-500\">(8)</span></button>\n          <button class=\"px-3 py-2 text-zinc-400 hover:text-zinc-200\">Agent Mesh</button>\n          <button class=\"px-3 py-2 text-zinc-400 hover:text-zinc-200\">Git</button>\n          <button class=\"px-3 py-2 text-zinc-400 hover:text-zinc-200\">Artifacts</button>\n          <button class=\"px-3 py-2 text-zinc-400 hover:text-zinc-200\">Activity</button>\n        </div>\n\n        <div class=\"flex-1 overflow-auto scrollbar-thin\">\n          <div class=\"grid grid-cols-3 gap-4 p-6\">\n            <!-- Left: Description + Agent stream -->\n            <div class=\"col-span-2 space-y-4\">\n              <!-- Description card -->\n              <section class=\"rounded-lg border border-zinc-800 bg-zinc-900/40 p-4\">\n                <h2 class=\"text-xs uppercase tracking-wider text-zinc-500 mb-2\">Description</h2>\n                <p class=\"text-sm text-zinc-300 leading-relaxed\">Replace the current bearer-token middleware with a pluggable OIDC layer supporting Google, GitHub, and Okta. Maintain backward compatibility for existing service tokens for a deprecation window.</p>\n                <div class=\"mt-3 flex flex-wrap gap-1.5\">\n                  <span class=\"text-[11px] px-2 py-0.5 rounded bg-zinc-800 text-zinc-300\">auth</span>\n                  <span class=\"text-[11px] px-2 py-0.5 rounded bg-zinc-800 text-zinc-300\">oidc</span>\n                  <span class=\"text-[11px] px-2 py-0.5 rounded bg-zinc-800 text-zinc-300\">breaking-change</span>\n                </div>\n              </section>\n\n              <!-- Agent thinking stream -->\n              <section class=\"rounded-lg border border-zinc-800 bg-zinc-900/40 overflow-hidden\">\n                <div class=\"flex items-center justify-between px-4 py-2.5 border-b border-zinc-800\">\n                  <div class=\"flex items-center gap-2 text-sm\">\n                    <span class=\"w-2 h-2 rounded-full bg-indigo-400 pulse-dot\"></span>\n                    <span class=\"text-zinc-200 font-medium\">Coordinator \u00b7 ArchitectAgent</span>\n                    <span class=\"text-xs text-zinc-500\">thinking\u2026</span>\n                  </div>\n                  <span class=\"text-[11px] text-zinc-500\">step 4/7</span>\n                </div>\n                <div class=\"p-4 space-y-3 text-sm font-mono\">\n                  <div class=\"text-zinc-400\"><span class=\"text-indigo-400\">\u25b8</span> Analyzing current middleware entry points\u2026</div>\n                  <div class=\"text-zinc-400\"><span class=\"text-emerald-400\">\u2713</span> Mapped 3 auth strategies across 12 routes</div>\n                  <div class=\"text-zinc-400\"><span class=\"text-emerald-400\">\u2713</span> Drafted OIDC config schema (provider, client_id, scopes)</div>\n                  <div class=\"text-zinc-300 typing\"><span class=\"text-indigo-400\">\u25b8</span> Planning migration path to preserve legacy tokens</div>\n                </div>\n              </section>\n\n              <!-- Git info card -->\n              <section class=\"rounded-lg border border-zinc-800 bg-zinc-900/40 p-4\">\n                <div class=\"flex items-center justify-between mb-3\">\n                  <h2 class=\"text-xs uppercase tracking-wider text-zinc-500\">Git</h2>\n                  <span class=\"text-[11px] text-zinc-500\">feature/oidc-middleware</span>\n                </div>\n                <div class=\"grid grid-cols-3 gap-3 text-sm\">\n                  <div class=\"rounded bg-zinc-950/60 border border-zinc-800 p-2.5\"><div class=\"text-xs text-zinc-500\">Commits</div><div class=\"text-zinc-100 font-medium\">14</div></div>\n                  <div class=\"rounded bg-zinc-950/60 border border-zinc-800 p-2.5\"><div class=\"text-xs text-zinc-500\">Files</div><div class=\"text-zinc-100 font-medium\">27</div></div>\n                  <div class=\"rounded bg-zinc-950/60 border border-zinc-800 p-2.5\"><div class=\"text-xs text-zinc-500\">+ / \u2212</div><div class=\"text-zinc-100 font-medium\"><span class=\"text-emerald-400\">+842</span> / <span class=\"text-rose-400\">\u2212193</span></div></div>\n                </div>\n                <button class=\"mt-3 w-full text-xs py-2 rounded border border-zinc-700 text-zinc-300 hover:bg-zinc-800 flex items-center justify-center gap-1.5\">\n                  <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"/></svg>\n                  Open Pull Request #214\n                </button>\n              </section>\n            </div>\n\n            <!-- Right: Side rail -->\n            <aside class=\"space-y-4\">\n              <!-- Assignees -->\n              <section class=\"rounded-lg border border-zinc-800 bg-zinc-900/40 p-3\">\n                <h3 class=\"text-[10px] uppercase tracking-wider text-zinc-500 mb-2\">Assignees</h3>\n                <div class=\"flex flex-wrap gap-1.5\">\n                  <span class=\"inline-flex items-center gap-1.5 text-xs px-2 py-1 rounded-full bg-zinc-800 text-zinc-200\"><span class=\"w-4 h-4 rounded-full bg-pink-500\"></span>@maria</span>\n                  <span class=\"inline-flex items-center gap-1.5 text-xs px-2 py-1 rounded-full bg-zinc-800 text-zinc-200\"><span class=\"w-4 h-4 rounded-full bg-cyan-500\"></span>@devon</span>\n                  <span class=\"text-xs px-2 py-1 text-indigo-400 cursor-pointer\">+ add</span>\n                </div>\n              </section>\n\n              <!-- Phase -->\n              <section class=\"rounded-lg border border-zinc-800 bg-zinc-900/40 p-3\">\n                <h3 class=\"text-[10px] uppercase tracking-wider text-zinc-500 mb-2\">Phase</h3>\n                <div class=\"space-y-1.5 text-xs\">\n                  <div class=\"flex items-center gap-2 text-emerald