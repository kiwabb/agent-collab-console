data: {"candidate_id": "next-app-router--settings", "prototype_id": "5ca1bf8f-f58e-41f4-ae9f-cd2af6e605c3", "version_no": 2, "html": "<!DOCTYPE html>\n<!-- source: /settings frontend/src/app/settings/page.tsx -->\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>\u8bbe\u7f6e \u00b7 Agent Collab Console</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n  :root { color-scheme: light dark; }\n  body { font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif; }\n  .scrollbar-thin::-webkit-scrollbar { width: 6px; height: 6px; }\n  .scrollbar-thin::-webkit-scrollbar-thumb { background: rgba(120,120,140,.35); border-radius: 3px; }\n  [data-theme=\"dark\"] { background: #0b0d12; color: #e6e8ef; }\n  [data-theme=\"light\"] { background: #f7f8fb; color: #1a1d24; }\n  .glass { backdrop-filter: blur(8px); }\n  .dot { width:8px;height:8px;border-radius:9999px;display:inline-block; }\n  details > summary { list-style: none; cursor: pointer; }\n  details > summary::-webkit-details-marker { display:none; }\n</style>\n</head>\n<body class=\"min-h-dvh antialiased\" data-theme=\"dark\">\n<div class=\"relative isolate h-dvh overflow-hidden\">\n  <!-- ambient background -->\n  <div class=\"pointer-events-none absolute inset-0 opacity-60\"\n       style=\"background:\n         radial-gradient(60% 50% at 15% 10%, rgba(99,102,241,.18), transparent 60%),\n         radial-gradient(50% 40% at 85% 20%, rgba(16,185,129,.14), transparent 60%),\n         radial-gradient(40% 30% at 50% 95%, rgba(244,114,182,.12), transparent 60%);\"></div>\n\n  <div class=\"relative flex h-full\">\n    <!-- Sidebar -->\n    <aside id=\"sidebar\" class=\"hidden md:flex w-60 shrink-0 flex-col border-r border-white/5 bg-white/[.03] glass\">\n      <div class=\"h-14 flex items-center gap-2 px-4 border-b border-white/5\">\n        <div class=\"size-7 rounded-md bg-gradient-to-br from-indigo-500 to-emerald-400 grid place-items-center text-white text-xs font-bold\">AC</div>\n        <div class=\"text-sm font-semibold tracking-wide\">Agent Collab</div>\n      </div>\n      <nav class=\"flex-1 overflow-y-auto p-2 text-sm scrollbar-thin\">\n        <div class=\"px-2 pt-2 pb-1 text-[11px] uppercase tracking-wider text-white/40\">\u5de5\u4f5c\u53f0</div>\n        <a href=\"#\" class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-white/5 text-white/80\">\ud83c\udfe0 \u6982\u89c8</a>\n        <a href=\"#\" class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-white/5 text-white/80\">\ud83d\udcac \u4f1a\u8bdd</a>\n        <a href=\"#\" class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-white/5 text-white/80\">\ud83e\udde9 \u4ee3\u7406</a>\n        <a href=\"#\" class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-white/5 text-white/80\">\ud83d\udce6 \u5236\u54c1</a>\n        <div class=\"mt-3 px-2 pt-2 pb-1 text-[11px] uppercase tracking-wider text-white/40\">\u7cfb\u7edf</div>\n        <a href=\"#\" class=\"flex items-center gap-2 px-2 py-1.5 rounded-md bg-white/10 text-white\">\u2699\ufe0f \u8bbe\u7f6e</a>\n        <a href=\"#\" class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-white/5 text-white/80\">\ud83d\udcc8 \u76d1\u63a7</a>\n        <a href=\"#\" class=\"flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-white/5 text-white/80\">\ud83e\uddea \u5b9e\u9a8c</a>\n      </nav>\n      <div class=\"p-3 border-t border-white/5 text-xs text-white/50\">\n        <div class=\"flex items-center gap-2\"><span class=\"dot bg-emerald-400\"></span> \u7f51\u5173\u5728\u7ebf</div>\n        <div class=\"mt-1 text-white/40\">v0.42.1 \u00b7 build 3a9f</div>\n      </div>\n    </aside>\n\n    <!-- Main -->\n    <main class=\"flex-1 flex min-w-0 flex-col\">\n      <!-- Header -->\n      <header class=\"h-14 shrink-0 flex items-center gap-3 px-4 border-b border-white/5 bg-white/[.02] glass\">\n        <button id=\"toggleSidebar\" class=\"md:hidden p-1.5 rounded-md hover:bg-white/5\">\u2630</button>\n        <nav class=\"text-sm text-white/60 flex items-center gap-1.5\" aria-label=\"breadcrumb\">\n          <span>\u5de5\u4f5c\u53f0</span>\n          <span class=\"text-white/30\">/</span>\n          <span class=\"text-white\">\u8bbe\u7f6e</span>\n        </nav>\n        <div class=\"ml-auto flex items-center gap-2\">\n          <div class=\"hidden sm:flex items-center gap-1 text-xs text-white/50 bg-white/5 rounded-md px-2 py-1\">\n            <span>\ud83d\udd0d</span><input class=\"bg-transparent outline-none w-40 placeholder:text-white/30\" placeholder=\"\u641c\u7d22\u8bbe\u7f6e\u2026\" />\n          </div>\n          <select id=\"localeSel\" class=\"text-xs bg-white/5 hover:bg-white/10 rounded-md px-2 py-1 outline-none\">\n            <option value=\"zh-CN\">\u4e2d\u6587 (\u7b80\u4f53)</option>\n            <option value=\"en-US\">English (US)</option>\n          </select>\n          <button class=\"text-xs px-2.5 py-1 rounded-md bg-white/5 hover:bg-white/10\">\u2318K</button>\n          <div class=\"size-7 rounded-full bg-gradient-to-br from-fuchsia-400 to-indigo-500 grid place-items-center text-[11px] font-semibold\">LZ</div>\n        </div>\n      </header>\n\n      <!-- Content -->\n      <div class=\"flex-1 min-h-0 overflow-y-auto scrollbar-thin\">\n        <div class=\"mx-auto max-w-5xl px-4 sm:px-6 py-6 space-y-6\">\n\n          <!-- Tabs -->\n          <div class=\"flex items-center gap-1 border-b border-white/5 text-sm overflow-x-auto\" role=\"tablist\">\n            <button data-tab=\"general\" class=\"tab px-3 py-2 border-b-2 border-indigo-400 text-white\">\u901a\u7528</button>\n            <button data-tab=\"appearance\" class=\"tab px-3 py-2 border-b-2 border-transparent text-white/60 hover:text-white\">\u5916\u89c2</button>\n            <button data-tab=\"runtime\" class=\"tab px-3 py-2 border-b-2 border-transparent text-white/60 hover:text-white\">\u8fd0\u884c\u65f6</button>\n            <button data-tab=\"privacy\" class=\"tab px-3 py-2 border-b-2 border-transparent text-white/60 hover:text-white\">\u9690\u79c1</button>\n            <button data-tab=\"advanced\" class=\"tab px-3 py-2 border-b-2 border-transparent text-white/60 hover:text-white\">\u9ad8\u7ea7</button>\n          </div>\n\n          <!-- Section: General -->\n          <section data-panel=\"general\" class=\"space-y-4\">\n            <div class=\"rounded-xl border border-white/5 bg-white/[.03] p-5\">\n              <div class=\"flex items-start justify-between gap-4\">\n                <div>\n                  <h2 class=\"text-base font-semibold\">\u4e2a\u4eba\u4fe1\u606f</h2>\n                  <p class=\"text-xs text-white/50 mt-0.5\">\u7528\u4e8e\u5728\u534f\u4f5c\u4f1a\u8bdd\u4e2d\u6807\u8bc6\u4f60\u7684\u8eab\u4efd\u3002</p>\n                </div>\n                <span class=\"text-[11px] px-2 py-0.5 rounded-full bg-emerald-400/10 text-emerald-300\">\u5df2\u540c\u6b65</span>\n              </div>\n              <div class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm\">\n                <label class=\"space-y-1\">\n                  <span class=\"text-white/60 text-xs\">\u663e\u793a\u540d\u79f0</span>\n                  <input value=\"Liu Ziyu\" class=\"w-full bg-white/5 border border-white/10 rounded-md px-2.5 py-1.5 outline-none focus:border-indigo-400\" />\n                </label>\n                <label class=\"space-y-1\">\n                  <span class=\"text-xs text-white/60\">\u90ae\u7bb1</span>\n                  <input value=\"liu@example.com\" class=\"w-full bg-white/5 border border-white/10 rounded-md px-2.5 py-1.5 outline-none focus:border-indigo-400\" />\n                </label>\n                <label class=\"space-y-1 sm:col-span-2\">\n                  <span class=\"text-xs text-white/60\">\u4e2a\u6027\u7b7e\u540d</span>\n                  <textarea rows=\"2\" class=\"w-full bg-white/5 border border-white/10 rounded-md px-2.5 py-1.5 outline-none focus:border-indigo-400\">\u504f\u597d\u4f4e\u6210\u672c\u3001\u53ef\u89e3\u91ca\u7684\u591a\u4ee3\u7406\u534f\u4f5c\u3002</textarea>\n                </label>\n              </div>\n            </div>\n\n            <div class=\"rounded-xl border border-white/5 bg-white/[.03] p-5\">\n              <h2 class=\"text-base font-semibold\">\u901a\u77e5\u504f\u597d</h2>\n              <p class=\"text-xs text-white/50 mt-0.5\">\u9009\u62e9\u5728\u4f55\u65f6\u901a\u8fc7\u6d4f\u89c8\u5668\u6216\u7cfb\u7edf\u901a\u77e5\u6253\u6270\u4f60\u3002</p>\n              <div class=\"mt-4 divide-y divide-white/5 text-sm\">\n                <div class=\"flex items-center justify-between py-2.5\">\n                  <div><div>\u4ee3\u7406\u5b8c\u6210\u4efb\u52a1</div><div class=\"text-xs text-white/40\">\u7ec8\u7aef\u4e8b\u4ef6\uff0c\u542b\u5931\u8d25\u4e0e\u53d6\u6d88</div></div>\n                  <label class=\"inline-flex items-center cursor-pointer\"><input type=\"checkbox\" checked class=\"peer sr-only\"><span class=\"w-9 h-5 bg-white/10 peer-checked:bg-indigo-500 rounded-full relative transition\"><span class=\"absolute top-0.5 left-0.5 size-4 bg-white rounded-full peer-checked:translate-x-4 transition\"></span></span></label>\n                </div>\n                <div class=\"flex items-center justify-between py-2.5\">\n                  <div><div>@\u63d0\u53ca</div><div class=\"text-xs text-white/40\">\u4ec5\u9650\u4e0e\u6211\u76f8\u5173</div></div>\n                  <label class=\"inline-flex items-center cursor-pointer\"><input type=\"checkbox\" checked class=\"peer sr-only\"><span class=\"w-9 h-5 bg-white/10 peer-checked:bg-indigo-500 rounded-full relative transition\"><span class=\"absolute top-0.5 left-0.5 size-4 bg-white rounded-full peer-checked:translate-x-4 transition\"></span></span></label>\n                </div>\n                <div class=\"flex items-center justify-between py-2.5\">\n                  <div><div>\u7cfb\u7edf\u516c\u544a</div><div class=\"text-xs text-white/40\">\u7ef4\u62a4\u3001\u7248\u672c\u66f4\u65b0</div></div>\n                  <label class=\"inline-flex items-center cursor-pointer\"><input type=\"checkbox\" class=\"peer sr-only\"><span class=\"w-9 h-5 bg-white/10 peer-checked:bg-indigo-500 rounded-full relative transition\"><span class=\"absolute top-0.5 left-0.5 size-4 bg-white rounded-full peer-checked:translate-x-4 transition\"></span></span></label>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          <!-- Section: Appearance -->\n          <section data-panel=\"appearance\" class=\"space-y-4 hidden\">\n            <div class=\"rounded-xl border border-white/5 bg-white/[.03] p-5\">\n              <h2 class=\"text-base font-semibold\">\u4e3b\u9898</h2>\n              <p class=\"text-xs text-white/50 mt-0.5\">\u9009\u62e9\u754c\u9762\u5916\u89c2\u3002</p>\n              <div class=\"mt-4 grid grid-cols-3 gap-3 text-sm\">\n                <button data-theme-choice=\"light\" class=\"rounded-lg border border-white/10 p-3 text-left hover:border-white/30\">\n                  <div class=\"h-16 rounded-md bg-gradient-to-br from-white to-slate-200 border border-black/10\"></div>\n                  <div class=\"mt-2 flex items-center gap-1.5\">\u2600\ufe0f \u6d45\u8272</div>\n                </button>\n                <button data-theme-choice=\"dark\" class=\"rounded-lg border border-indigo-400/60 p-3 text-left bg-white/5\">\n                  <div class=\"h-16 rounded-md bg-gradient-to-br from-slate-800 to-slate-950 border border-white/10\"></div>\n                  <div class=\"mt-2 flex items-center gap-1.5\">\ud83c\udf19 \u6df1\u8272</div>\n                </button>\n                <button data-theme-choice=\"system\" class=\"rounded-lg border border-white/10 p-3 text-left hover:border-white/30\">\n                  <div class=\"h-16 rounded-md bg-gradient-to-r from-white via-slate-300 to-slate-900\"></div>\n                  <div class=\"mt-2 flex items-center gap-1.5\">\ud83d\udcbb \u8ddf\u968f\u7cfb\u7edf</div>\n                </button>\n              </div>\n            </div>\n\n            <div class=\"rounded-xl border border-white/5 bg-white/[.03] p-5\">\n              <h2 class=\"text-base font-semibold\">\u5b57\u53f7 & \u5bc6\u5ea6</h2>\n              <div class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm\">\n                <label class=\"space-y-2\">\n                  <span class=\"text-xs text-white/60\">\u5b57\u53f7</span>\n                  <div class=\"flex gap-1\">\n                    <button class=\"px-2.5 py-1 rounded-md bg-white/5 text-xs\">\u5c0f</button>\n                    <button class=\"px-2.5 py-1 rounded-md bg-indigo-500/80 text-xs\">\u4e2d</button>\n                    <button class=\"px-2.5 py-1 rounded-md bg-white/5 text-xs\">\u5927</button>\n                  </div>\n                </label>\n                <label class=\"space-y-2\">\n                  <span class=\"text-xs text-white/60\">\u754c\u9762\u5bc6\u5ea6</span>\n                  <div class=\"flex gap-1\">\n                    <button class=\"px-2.5 py-1 rounded-md bg-white/5 text-xs\">\u7d27\u51d1</button>\n                    <button class=\"px-2.5 py-1 rounded-md bg-indigo-500/80 text-xs\">\u6807\u51c6</button>\n                    <button class=\"px-2.5 py-1 rounded-md bg-white/5 text-xs\">\u5bbd\u677e</button>\n                  </div>\n                </label>\n              </div>\n            </div>\n          </section>\n\n          <!-- Section: Runtime -->\n          <section data-panel=\"runtime\" class=\"space-y-4 hidden\">\n            <div class=\"rounded-xl border border-white/5 bg-white/[.03] p-5\">\n              <div class=\"flex items-start justify-between\">\n                <div>\n                  <h2 class=\"text-base font-semibold\">\u8fd0\u884c\u65f6\u76ee\u5f55</h2>\n                  <p class=\"text-xs text-white/50 mt-0.5\">\u7ba1\u7406\u53ef\u7528\u4e8e\u4ee3\u7406\u7684\u6a21\u578b\u4e0e\u5de5\u5177\u76ee\u5f55\u3002</p>\n                </div>\n                <button class=\"text-xs px-2.5 py-1 rounded-md bg-indigo-500 hover:bg-indigo-400 text-white\">\u4fdd\u5b58\u4fee\u6539</button>\n              </div>\n              <!-- Loading -->\n              <div id=\"rtLoading\" class=\"mt-4 flex items-center gap-2 text-xs text-white/50\">\n                <span class=\"size-3 rounded-full border-2 border-white/20 border-t-white/70 animate-spin\"></span>\n                \u6b63\u5728\u52a0\u8f7d\u8fd0\u884c\u65f6\u76ee\u5f55\u2026\n              </div>\n              <!-- Loaded -->\n              <div id=\"rtLoaded\" class=\"mt-4 hidden space-y-3 text-sm\">\n                <details class=\"rounded-lg border border-white/10 bg-white/[.02]\" open>\n                  <summary class=\"flex items-center justify-between p-3\">\n                    <div class=\"flex items-center gap-2\">\ud83e\udd16 <span class=\"font-medium\">LLM \u6a21\u578b</span><span class=\"text-[10px] text-white/40\">12 \u9879</span></div>\n                    <span class=\"text-white/40 text-xs\">\u25be</span>\n                  </summary>\n                  <div class=\"px-3 pb-3 space-y-2\">\n                    <div class=\"flex items-center justify-between text-xs\"><span>gpt-4o-mini \u00b7 OpenAI</span><span class=\"text-emerald-300\">\u5df2\u542f\u7528</span></div>\n                    <div class=\"flex items-center justify-between text-xs\"><span>claude-3.5-sonnet \u00b7 Anthropic</span><span class=\"text-emerald-300\">\u5df2\u542f\u7528</span></div>\n                    <div class=\"flex items-center justify-between text-xs\"><span>qwen2.5-72b \u00b7 \u81ea\u6258\u7ba1</span><span class=\"text-white/40\">\u672a\u542f\u7528</span></div>\n                    <div class=\"text-white/40 text-[11px]\">\u5176\u4f59 9 \u9879\u5df2\u6298\u53e0\u2026</div>\n                  </div>\n                </details>\n                <details class=\"rounded-lg border border-white/10 bg-white/[.02]\">\n                  <summary class=\"flex items-center justify-between p-3\">\n                    <div class=\"flex items-center gap-2\">\ud83d\udee0\ufe0f <span class=\"font-medium\">\u5de5\u5177</span><span class=\"text-[10px] text-white/40\">38 \u9879</span></div>\n                    <span class=\"text-white/40 text-xs\">\u25b8</span>\n                  </summary>\n                </details>\n                <details class=\"rounded-lg border border-white/10 bg-white/[.02]\">\n                  <summary class=\"flex items-center justify-between p-3\">\n                    <div class=\"flex items-center gap-2\">\ud83d\uddc2\ufe0f <span class=\"font-medium\">\u77e5\u8bc6\u5e93</span><span class=\"text-[10px] text-white/40\">5 \u9879</span></div>\n                    <span class=\"text-white/40 text-xs\">\u25b8</span>\n                  </summary>\n                </details>\n              </div>\n              <!-- Error -->\n              <div id=\"rtError\" class=\"hidden mt-4 rounded-lg border border-rose-400/30 bg-rose-400/10 p-3 text-xs text-rose-200\">\n                \u52a0\u8f7d\u5931\u8d25\uff1a\u65e0\u6cd5\u8fde\u63a5\u5230 /api/runtime\u3002\u53ef\u7a0d\u540e\u91cd\u8bd5\u3002\n              </div>\n            </div>\n          </section>\n\n          <!-- Section: Privacy -->\n          <section data-panel=\"privacy\" class=\"space-y-4 hidden\">\n            <div class=\"rounded-xl border border-white/5 bg-white/[.03] p-5 text-sm space-y-3\">\n              <h2 class=\"text-base font-semibold\">\u6570\u636e\u4e0e\u9065\u6d4b</h2>\n              <div class=\"flex items-center justify-between py-2 border-b border-white/5\">\n                <div><div>\u53d1\u9001\u533f\u540d\u4f7f\u7528\u6570\u636e</div><div class=\"text-xs text-white/40\">\u5e2e\u52a9\u6539\u8fdb\u4ea7\u54c1\uff0c\u4e0d\u542b\u4f1a\u8bdd\u5185\u5bb9</div></div>\n                <label class=\"inline-flex items-center cursor-pointer\"><input type=\"checkbox\" checked class=\"peer sr-only\"><span class=\"w-9 h-5 bg-white/10 peer-checked:bg-indigo-500 rounded-full relative transition\"><span class=\"absolute top-0.5 left-0.5 size-4 bg-white rounded-full peer-checked:translate-x-4 transition\"></span></span></label>\n              </div>\n              <div class=\"flex items-center justify-between py-2 border-b border-white/5\">\n                <div><div>\u672c\u5730\u4fdd\u7559\u4f1a\u8bdd\u5386\u53f2</div><div class=\"text-xs text-white/40\">\u6700\u957f 30 \u5929</div></div>\n                <label class=\"inline-flex items-center cursor-pointer\"><input type=\"checkbox\" class=\"peer sr-only\"><span class=\"w-9 h-5 bg-white/10 peer-checked:bg-indigo-500 rounded-full relative transition\"><span class=\"absolute top-0.5 left-0.5 size-4 bg-white rounded-full peer-checked:translate-x-4 transition\"></span></span></label>\n              </div>\n              <div class=\"flex gap-2 pt-2\">\n                <button class=\"text-xs px-3 py-1.5 rounded-md bg-white/5 hover:bg-white/10\">\u5bfc\u51fa\u5168\u90e8\u6570\u636e</button>\n                <button class=\"text-xs px-3 py-1.5 rounded-md bg-rose-500/20 text-rose-200 hover:bg-rose-500/30\">\u6e05\u7a7a\u672c\u5730\u7f13\u5b58</button>\n              </div>\n            </div>\n          </section>\n\n          <!-- Section: Advanced -->\n          <section data-panel=\"advanced\" class=\"space-y-4 hidden\">\n            <div class=\"rounded-xl border border-white/5 bg-white/[.03] p-5 text-sm\">\n              <h2 class=\"text-base font-semibold\">\u5b9e\u9a8c\u6027\u529f\u80fd</h2>\n              <p class=\"text-xs text-white/50 mt-0.5\">\u8fd9\u4e9b\u529f\u80fd\u53ef\u80fd\u4e0d\u7a33\u5b9a\u3002</p>\n              <div class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div class=\"rounded-lg border border-white/10 p-3\">\n                  <div class=\"flex items-center justify-between\"><div class=\"font-medium\">\ud83e\uddea \u591a\u4ee3\u7406\u7f16\u6392 v2</div><span class=\"text-[10px] px-1.5 py-0.5 rounded bg-amber-400/15 text-amber-300\">Beta</span></div>\n                  <p class=\"text-xs text-white/40 mt-1\">\u652f\u6301\u5d4c\u5957\u89c4\u5212\u4e0e\u89d2\u8272\u56de\u6536\u3002</p>\n                </div>\n                <div class=\"rounded-lg border border-white/10 p-3\">\n                  <div class=\"flex items-center justify-between\"><div class=\"font-medium\">\ud83d\udd0c MCP \u6865\u63a5</div><span class=\"text-[10px] px-1.5 py-0.5 rounded bg-white/10 text-white/60\">Alpha</span></div>\n                  <p class=\"text-xs text-white/40 mt-1\">\u63a5\u5165\u5916\u90e8 Model Context Protocol \u670d\u52a1\u5668\u3002</p>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          <div class=\"h-12\"></div>\n        </div>\n      </div>\n\n      <!-- Status bar -->\n      <footer class=\"h-7 shrink-0 px-3 flex items-center gap-3 text-[11px] text-white/50 border-t border-white/5 bg-white/[.02]\">\n        <span class=\"flex items-center gap-1.5\"><span class=\"dot bg-emerald-400\"></span>\u5df2\u8fde\u63a5</span>\n        <span>\u00b7</span>\n        <span>\u5de5\u4f5c\u533a: default</span>\n        <span class=\"ml-auto\">\u2318S \u4fdd\u5b58</span>\n      </footer>\n    </main>\n  </div>\n</div>\n\n<script>\n  // Sidebar toggle (mobile)\n  document.getElementById('toggleSidebar')?.addEventListener('click', () => {\n    document.getElementById('sidebar')?.classList.toggle('hidden');\n  });\n\n  // Tabs\n  const tabs = document.querySelectorAll('.tab');\n  const panels = document.querySelectorAll('[data-panel]');\n  tabs.forEach(tab => {\n    tab.addEventListener('click', () => {\n      tabs.forEach(t => { t.classList.remove('border-indigo-400','text-white'); t.classList.add('border-transparent','text-white/60'); });\n      tab.classList.add('border-indigo-400','text-white'); tab.classList.remove('border-transparent','text-white/60');\n      const key = tab.dataset.tab;\n      panels.forEach(p => p.classList.toggle('hidden', p.dataset.panel !== key));\n    });\n  });\n\n  // Theme switcher\n  const themeMap = { light:'light', dark:'dark', system:'dark' };\n  document.querySelectorAll('[data-theme-choice]').forEach(btn => {\n    btn.addEventListener('click', () => {\n      const v = btn.dataset.themeChoice;\n      document.body.dataset.theme = themeMap[v] || 'dark';\n      document.querySelectorAll('[data-theme-choice]').forEach(b => b.classList.remove('border-indigo-400/60','bg-white/5'));\n      btn.classList.add('border-indigo-400/60','bg-white/5');\n    });\n  });\n\n  // Locale switch (visual only)\n  const dict = {\n    'zh-CN': { title:'\u8bbe\u7f6e', runtimeLoad:'\u6b63\u5728\u52a0\u8f7d\u8fd0\u884c\u65f6\u76ee\u5f55\u2026', runtimeFail:'\u52a0\u8f7d\u5931\u8d25' },\n    'en-US': { title:'Settings', runtimeLoad:'Loading runtime catalog\u2026', runtimeFail:'Failed to load' }\n  };\n  document.getElementById('localeSel')?.addEventListener('change', (e) => {\n    const loc = e.target.value;\n    // simulate i18n on runtime panel labels\n    if (loc === 'en-US') {\n      document.querySelector('#rtLoading').lastChild.textContent = ' ' + dict['en-US'].runtimeLoad;\n    } else {\n      document.querySelector('#rtLoading').lastChild.textContent = ' ' + dict['zh-CN'].runtimeLoad;\n    }\n  });\n\n  // Simulate runtime catalog fetch\n  const loading = document.getElementById('rtLoading');\n  const loaded  = document.getElementById('rtLoaded');\n  const error   = document.getElementById('rtError');\n  setTimeout(() => {\n    // 80% success / 20% error to demo both states\n    if (Math.random() < 0.8) { loading.classList.add('hidden'); loaded.classList.remove('hidden'); }\n    else { loading.classList.add('hidden'); error.classList.remove('hidden'); }\n  }, 900);\n</script>\n</body>\n</html>", "disk_path": "/Users/zhoujiaangyao/zhoujiangyao/AI/jackmouse-ai/agent-collab-console/.agent-collab/prototypes/5ca1bf8f-f58e-41f4-ae9f-cd2af6e605c3/v2/index.html"}

