      <div class=\"mb-5\">\n        <h1 class=\"text-xl font-semibold\">原型设计</h1>\n        <p class=\"mt-1 text-sm text-slate-500\">用自然语言生成可交互 HTML 原型，并持续迭代版本。</p>\n      </div>\n\n      <div id=\"status\" class=\"mb-4 hidden rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800\"></div>\n\n      <div class=\"rounded-lg border border-slate-200 bg-white p-10 text-center\">\n        <div class=\"mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-indigo-50 text-2xl\">✨</div>\n        <h2 class=\"text-base font-semibold\">还没有原型</h2>\n        <p class=\"mx-auto mt-2 max-w-sm text-sm text-slate-500\">点击「新建原型」开始，从一段描述或一段代码快速生成可交互的 HTML 原型。</p>\n        <div class=\"mt-5 flex items-center justify-center gap-2\">\n          <button class=\"rounded bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700\" onclick=\"createPrototype()\">+ 新建原型</button>\n          <button class=\"rounded border border-slate-200 bg-white px-4 py-2 text-sm hover:bg-slate-50\" onclick=\"createPrototype()\">从代码生成</button>\n        </div>\n      </div>\n\n      <div id=\"list\" class=\"mt-6 hidden grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"></div>\n    </section>\n  </main>\n</div>\n\n<div id=\"toast\" class=\"fixed bottom-6 right-6 hidden rounded-lg border border-red-200 bg-white px-4 py-3 shadow-lg\">\n  <div class=\"text-sm font-medium text-red-700\">创建失败</div>\n  <div class=\"text-xs text-slate-500\">project not found: demo-id</div>\n</div>\n\n<script>\n  const status = document.getElementById('status');\n  const list = document.getElementById('list');\n  const toast = document.getElementById('toast');\n\n  function showError() {\n    status.textContent = '加载项目失败 — project not found: demo-id';\n    status.classList.remove('hidden');\n    toast.classList.remove('hidden');\n    setTimeout(() => toast.classList.add('hidden'), 3000);\n  }\n\n  function showLoading(title) {\n    status.innerHTML = '<span class=\"inline-block animate-pulse\">Loading…</span> 正在生成「' + title + '」';\n    status.classList.remove('hidden');\n  }\n\n  function createPrototype() {\n    const title = prompt('原型标题', 'New Title') || 'New Title';\n    showLoading(title);\n    setTimeout(() => {\n      status.classList.add('hidden');\n      renderList([{ id: 1, title, source: '从代码生成', updated: '刚刚' }]);\n    }, 900);\n  }\n\n  function renderList(items) {\n    list.classList.remove('hidden');\n    list.innerHTML = items.map(it => `\n      <div class=\"rounded-lg border border-slate-200 bg-white p-4\">\n        <div class=\"mb-2 flex items-center justify-between\">\n          <span class=\"rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600\">${it.source}</span>\n          <span class=\"text-xs text-slate-400\">${it.updated}</span>\n        </div>\n        <div class=\"text-sm font-medium\">${it.title}</div>\n        <div class=\"mt-3 flex gap-2 text-xs\">\n          <button class=\"rounded border border-slate-200 px-2 py-1 hover:bg-slate-50\">预览</button>\n          <button class=\"rounded border border-slate-200 px-2 py-1 hover:bg-slate-50\">迭代</button>\n        </div>\n      </div>\n    `).join('');\n  }\n\n  // Simulate initial project load failure based on runtime evidence\n  window.addEventListener('DOMContentLoaded', () => setTimeout(showError, 600));\n</script>\n</body>\n</html>",
