kground:#cdd3e2;transition:.2s;}\n  .switch.on{background:linear-gradient(135deg,var(--accent),var(--accent2));}\n  .switch.on::after{left:18px;background:#fff;}\n  .scrollbar::-webkit-scrollbar{width:8px;}\n  .scrollbar::-webkit-scrollbar-thumb{background:#2a3044;border-radius:4px;}\n  details>summary{list-style:none;cursor:pointer;}\n  details>summary::-webkit-details-marker{display:none;}\n</style>\n</head>\n<body class=\"h-dvh overflow-hidden\">\n\n<div class=\"flex h-full\">\n  <!-- Sidebar -->\n  <aside class=\"w-60 shrink-0 panel border-r border-[#222836] flex flex-col\">\n    <div class=\"px-4 py-4 flex items-center gap-2 border-b border-[#222836]\">\n      <div class=\"w-7 h-7 rounded-md bg-gradient-to-br from-[#5b8cff] to-[#7c5cff]\"></div>\n      <div>\n        <div class=\"text-sm font-semibold\">Agent Collab</div>\n        <div class=\"text-[11px] text-[#8a93a6]\">Console · v0.4.2</div>\n      </div>\n    </div>\n    <nav class=\"p-2 flex-1 overflow-y-auto scrollbar text-sm\">\n      <div class=\"px-2 pt-2 pb-1 text-[10px] uppercase tracking-wider text-[#6b7388]\">Workspace</div>\n      <a class=\"nav-item\" href=\"#\">🏠 Dashboard</a>\n      <a class=\"nav-item\" href=\"#\">💬 Conversations</a>\n      <a class=\"nav-item\" href=\"#\">🤖 Agents <span class=\"ml-auto chip text-[10px] px-1.5 py-0.5 rounded\">12</span></a>\n      <a class=\"nav-item\" href=\"#\">🧪 Runtimes</a>\n      <a class=\"nav-item\" href=\"#\">📦 Sessions</a>\n      <a class=\"px-2 pt-4 pb-1 text-[10px] uppercase tracking-wider text-[#6b7388]\">Manage</a>\n      <a class=\"nav-item\" href=\"#\">👥 Members</a>\n      <a class=\"nav-item\" href=\"#\">🔑 API Keys</a>\n      <a class=\"nav-item active\" href=\"#\">⚙️ Settings</a>\n    </nav>\n    <div class=\"p-3 border-t border-[#222836] flex items-center gap-2\">\n      <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500\"></div>\n      <div class=\"text-xs\">\n        <div class=\"font-medium\">lin.wei</div>\n  